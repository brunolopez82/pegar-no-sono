# Hostinger / Apache — servir o site estatico exportado pelo Next.js.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> sem www, numa so' redirecao permanente.
  # Sem isto, a CDN guarda duas copias independentes do site (uma por hostname)
  # e podem ficar dessincronizadas — foi exatamente o que aconteceu a 31/08/2026,
  # com o dominio a servir a versao nova e o www a servir a antiga.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /artigos/x -> /artigos/x/ (o export usa trailingSlash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# A CDN da Hostinger trata HTML estatico como ficheiro estatico e guarda o
# index.html com s-maxage=31536000 — um ano. Resultado: publica-se um artigo e o
# visitante continua a ver a versao anterior.
#
# Tres cabecalhos diferentes, porque cada CDN ouve um deles:
#   Cache-Control s-maxage  — o padrao, para caches partilhadas
#   CDN-Cache-Control       — tem precedencia sobre o anterior, so' para a CDN
#   Surrogate-Control       — o equivalente em Varnish/Fastly
#
# `always` em vez de `set` simples: aplica tambem a respostas que nao sejam 2xx.
#
# Os ficheiros com hash no nome (_next/static, imagens) mantem cache de um ano —
# esses nunca mudam sem mudar de nome.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt|json|webmanifest)$">
    Header always set Cache-Control "public, max-age=0, s-maxage=0, must-revalidate"
    Header always set CDN-Cache-Control "no-store"
    Header always set Surrogate-Control "no-store"
  </FilesMatch>

  # Testemunha: se este cabecalho nao chegar ao browser, o mod_headers esta
  # desligado ou a CDN esta a reescrever tudo — e a correcao tem de ser feita
  # no painel da Hostinger, nao aqui. Ver COMO-PUBLICAR.md.
  Header always set X-Origem-Htaccess "ativo"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

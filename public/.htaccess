# Hostinger / Apache — servir o site estatico exportado pelo Next.js.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /artigos/x -> /artigos/x/ (o export usa trailingSlash)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# A CDN da Hostinger trata HTML estatico como ficheiro estatico e chega a guardar
# o index.html durante um ano (s-maxage=31536000). Resultado: publica-se um artigo
# e o visitante continua a ver a versao anterior.
#
# s-maxage=0 fala especificamente com caches partilhadas (CDN), ao contrario do
# max-age, que so' fala com o browser. Os ficheiros com hash no nome (_next/static)
# continuam com cache de um ano — esses nunca mudam sem mudar de nome.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, s-maxage=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=0, s-maxage=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
